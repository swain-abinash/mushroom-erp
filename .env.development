# Database: Dedicated MariaDB Dev Database
DATABASE_URL="mysql://root:root@localhost:3306/sporeerp_dev?connection_limit=10&pool_timeout=20"

# Redis Cache & Sessions (Optional local dev)
REDIS_URL="redis://localhost:6379"

# Application URL & NextAuth v5 Secret
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
AUTH_SECRET="dev_auth_secret_994821a8b37c04e6e29783cb0d319e7a2b91485601c3"

# Founder Admin Initial Seed Credentials
SEED_ADMIN_NAME="Founder Admin (Dev)"
SEED_ADMIN_EMAIL="admin@sporeerp.local"
SEED_ADMIN_PASSWORD="Password123!"

# Payment Gateway (Razorpay Sandbox/Test Keys)
RAZORPAY_KEY_ID="rzp_test_dev_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_dev_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_dev_placeholder"

# Environment Tag
APP_ENV="development"
NODE_ENV="development"
