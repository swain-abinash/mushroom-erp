# ==============================================================================
# SPORE ERP — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.development, .env.uat, or .env.production
# ==============================================================================

# Database Configuration (MariaDB / MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?connection_limit=N&pool_timeout=S
DATABASE_URL="mysql://root:root@localhost:3306/sporeerp_dev?connection_limit=10&pool_timeout=20"

# Redis Cache / Rate Limiting (Optional in local dev)
REDIS_URL="redis://localhost:6379"

# NextAuth v5 Authentication
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Generate secret using: openssl rand -base64 32
AUTH_SECRET="your-32-character-random-hex-or-base64-secret"

# Founder Admin Seeding Defaults (Used by npm run db:seed)
SEED_ADMIN_NAME="Founder Admin"
SEED_ADMIN_EMAIL="admin@sporeerp.local"
SEED_ADMIN_PASSWORD="Password123!"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Environment Identifier: development | uat | production
APP_ENV="development"
NODE_ENV="development"
