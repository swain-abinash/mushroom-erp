# Copy to .env and fill in real values for local development.

# MariaDB — matches docker-compose.yml service defaults. Point the port at your MariaDB server
# (not a MySQL 8 server, whose caching_sha2_password auth breaks MariaDB clients).
# connection_limit / pool_timeout tune Prisma's connection pool (Sprint 1 spec).
DATABASE_URL="mysql://sporeerp:sporeerp_dev@localhost:3306/sporeerp?connection_limit=10&pool_timeout=20"

# Redis — session caching, rate limiting, pub/sub notifications.
REDIS_URL="redis://localhost:6379"

# Auth.js (NextAuth v5) — generate a secret with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-32-byte-random-string"
NEXTAUTH_URL="http://localhost:3000"
# Required when self-hosting (`next start` behind Nginx); Auth.js only auto-trusts the host in dev.
AUTH_TRUST_HOST=true

# Founder admin created by `npm run db:seed` (skipped when unset). Change the password after first login.
SEED_ADMIN_NAME="Founder Admin"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Razorpay (Sprint 5 — payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
