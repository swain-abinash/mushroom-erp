# ==============================================================================
# SPORE ERP — PRODUCTION ENVIRONMENT (.env.production)
# Used for live commercial farm operations, real customer orders, and financial accounting.
# NEVER commit production passwords or real API secrets to public repositories.
# ==============================================================================

# Database: Production MariaDB / MySQL (e.g. AWS RDS, DigitalOcean, or Dedicated VPS)
DATABASE_URL="mysql://root:root@localhost:3306/sporeerp_prod?connection_limit=25&pool_timeout=30"

# Redis Cache & Sessions (Managed Redis Cluster / TLS recommended)
REDIS_URL="redis://localhost:6379"

# Application URL & Production NextAuth Secret (Generate with `openssl rand -base64 32`)
NEXTAUTH_URL="https://erp.yourfarmdomain.com"
AUTH_TRUST_HOST=true
AUTH_SECRET="prod_super_secure_auth_secret_replace_with_openssl_generated_value"

# Founder Admin Initial Seed Credentials (Change immediately upon deployment!)
SEED_ADMIN_NAME="Founder & CEO"
SEED_ADMIN_EMAIL="founder@yourfarmdomain.com"
SEED_ADMIN_PASSWORD="ReplaceWithUltraSecurePassword2026!"

# Production Razorpay Live Credentials
RAZORPAY_KEY_ID="rzp_live_replace_with_actual_key"
RAZORPAY_KEY_SECRET="replace_with_actual_live_secret"
RAZORPAY_WEBHOOK_SECRET="replace_with_actual_webhook_secret"

# Environment Tag
APP_ENV="production"
NODE_ENV="production"
