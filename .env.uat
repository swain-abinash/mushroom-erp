# ==============================================================================
# SPORE ERP — UAT / STAGING ENVIRONMENT (.env.uat)
# Used for business owner acceptance testing, farm manager walkthroughs, and client sign-off.
# Completely isolated from Dev so test data does not affect acceptance tests.
# ==============================================================================

# Database: Dedicated MariaDB UAT Database
DATABASE_URL="mysql://root:root@localhost:3306/sporeerp_uat?connection_limit=15&pool_timeout=25"

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379"

# Application URL & NextAuth v5 Secret
NEXTAUTH_URL="http://localhost:3001"
AUTH_TRUST_HOST=true
AUTH_SECRET="uat_auth_secret_772183b9c4819ad02e482716ef9301827461829038ba"

# Founder Admin Initial Seed Credentials for Acceptance Testing
SEED_ADMIN_NAME="Founder Admin (UAT)"
SEED_ADMIN_EMAIL="admin@sporeerp.local"
SEED_ADMIN_PASSWORD="Password123!"

# Payment Gateway (Razorpay Sandbox/Test Keys for staging)
RAZORPAY_KEY_ID="rzp_test_uat_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_uat_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_uat_placeholder"

# Environment Tag
APP_ENV="uat"
NODE_ENV="production"
