{
  "name": "sporeerp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/run-env.ts dev dev",
    "dev:uat": "tsx scripts/run-env.ts uat dev",
    "dev:prod": "tsx scripts/run-env.ts prod dev",
    "build": "next build",
    "build:uat": "tsx scripts/run-env.ts uat build",
    "build:prod": "tsx scripts/run-env.ts prod build",
    "start": "next start",
    "start:uat": "tsx scripts/run-env.ts uat start",
    "start:prod": "tsx scripts/run-env.ts prod start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "env:setup": "node --conditions=react-server --import=tsx scripts/setup-environments.ts all",
    "env:setup:dev": "node --conditions=react-server --import=tsx scripts/setup-environments.ts dev",
    "env:setup:uat": "node --conditions=react-server --import=tsx scripts/setup-environments.ts uat",
    "env:setup:prod": "node --conditions=react-server --import=tsx scripts/setup-environments.ts prod",
    "test:e2e": "node --conditions=react-server --import=tsx scripts/test-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
